+static cl::opt<bool> ExperimentFoldO0SubregRoundtrip(
+    "experiment-fold-o0-subreg-roundtrip", cl::Hidden, cl::init(false),
+    cl::desc("Fold narrow extract of undef-based insert before O0 fast RA"));
+
+// Only forward an exact 32-bit value through a sole-use 64-bit wrapper.
+// hasOneUse includes debug uses: never discard a separately observed wrapper.
+static void foldO0SubregRoundtrips(MachineFunction &MF,
+                                  MachineRegisterInfo &MRI,
+                                  const TargetRegisterInfo &TRI) {
+  if (!ExperimentFoldO0SubregRoundtrip || !MRI.isSSA() ||
+      (MF.getTarget().getOptLevel() != CodeGenOpt::None &&
+       !MF.getFunction()->hasFnAttribute(Attribute::OptimizeNone)))
+    return;
+  for (MachineBasicBlock &MBB : MF) {
+    for (auto I = MBB.begin(), E = MBB.end(); I != E;) {
+      MachineInstr &Copy = *I++;
+      if (!Copy.isCopy() || Copy.getNumOperands() != 2)
+        continue;
+      MachineOperand &Dst = Copy.getOperand(0), &Ext = Copy.getOperand(1);
+      if (!Dst.isReg() || !Ext.isReg() || Dst.getSubReg() ||
+          !Ext.getSubReg() || Ext.isUndef() ||
+          !TargetRegisterInfo::isVirtualRegister(Dst.getReg()) ||
+          !TargetRegisterInfo::isVirtualRegister(Ext.getReg()) ||
+          !MRI.hasOneDef(Ext.getReg()) || !MRI.hasOneUse(Ext.getReg()))
+        continue;
+      MachineInstr *Insert = MRI.getVRegDef(Ext.getReg());
+      if (Insert->getOpcode() != TargetOpcode::INSERT_SUBREG ||
+          Insert->getNumOperands() != 4 || Insert->getParent() != &MBB ||
+          Insert->getOperand(0).getSubReg() ||
+          Insert->getOperand(3).getImm() != Ext.getSubReg())
+        continue;
+      const MachineOperand &Base = Insert->getOperand(1);
+      const MachineOperand &Val = Insert->getOperand(2);
+      if (!Base.isReg() || !Val.isReg() || Base.getSubReg() ||
+          Val.getSubReg() || Val.isUndef() ||
+          !TargetRegisterInfo::isVirtualRegister(Base.getReg()) ||
+          !TargetRegisterInfo::isVirtualRegister(Val.getReg()) ||
+          !MRI.hasOneDef(Base.getReg()) || !MRI.hasOneUse(Base.getReg()) ||
+          !MRI.hasOneDef(Val.getReg()))
+        continue;
+      MachineInstr *Undef = MRI.getVRegDef(Base.getReg());
+      if (!Undef->isImplicitDef() || Undef->getParent() != &MBB ||
+          TRI.getRegSizeInBits(*MRI.getRegClass(Ext.getReg())) != 64 ||
+          TRI.getRegSizeInBits(*MRI.getRegClass(Val.getReg())) != 32 ||
+          TRI.getRegSizeInBits(*MRI.getRegClass(Dst.getReg())) != 32 ||
+          !MRI.constrainRegClass(Val.getReg(), MRI.getRegClass(Dst.getReg())))
+        continue;
+      unsigned SrcReg = Val.getReg();
+      // Register-class intersection preserves every source and destination use.
+      // SSA guarantees the forwarded definition dominates the original copy.
+      MRI.replaceRegWith(Dst.getReg(), SrcReg);
+      MRI.clearKillFlags(SrcReg);
+      Copy.eraseFromParent();
+      Insert->eraseFromParent();
+      Undef->eraseFromParent();
+    }
+  }
