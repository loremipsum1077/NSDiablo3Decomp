+
+/// Relocation-backed GOT evidence. Invalid/duplicate relocations remain visible
+/// rather than being silently omitted and mistaken for an unchecked reference.
+pub struct GotTarget {
+    pub address: u64,
+    pub symbol_name: Option<String>,
+}
+
+pub type GotTargets = FxHashMap<u64, std::result::Result<GotTarget, String>>;
+
+pub fn build_got_targets(elf: &OwnedElf) -> Result<GotTargets> {
+    let mut targets = GotTargets::default();
+    let Ok(got) = find_section(elf, ".got") else { return Ok(targets); };
+    let Ok(header) = find_section(elf, ".rela.dyn") else { return Ok(targets); };
+    let bytes = &elf.as_owner().1;
+    let relocs = RelocSection::parse(bytes, header.sh_offset as usize,
+        header.sh_size as usize, true, make_goblin_ctx())?;
+    let sym_header = get_linked_section(elf, header)?;
+    let symbols = parse_symtab(elf, sym_header)?;
+    let strings_header = get_linked_section(elf, sym_header)?;
+    let strings = Strtab::parse(bytes, strings_header.sh_offset as usize,
+        strings_header.sh_size as usize, 0)?;
+    for relocation in relocs.iter().filter(|r| is_in_section(got, r.r_offset, 8)) {
+        let resolved = (|| -> Result<GotTarget> {
+            let addend = relocation.r_addend.context("missing GOT relocation addend")?;
+            match relocation.r_type {
+                reloc::R_AARCH64_RELATIVE => {
+                    if relocation.r_sym != 0 { bail!("RELATIVE GOT relocation has a symbol index"); }
+                    Ok(GotTarget { address: u64::try_from(addend)
+                        .context("negative RELATIVE GOT address")?, symbol_name: None })
+                }
+                reloc::R_AARCH64_GLOB_DAT => {
+                    let symbol = symbols.get(relocation.r_sym).context("invalid GOT symbol index")?;
+                    if symbol.st_shndx == section_header::SHN_UNDEF as usize {
+                        bail!("undefined GOT target symbol");
+                    }
+                    let name = strings.get_at(symbol.st_name).context("invalid GOT symbol name")?;
+                    if name.is_empty() { bail!("empty GOT symbol name"); }
+                    let value = (symbol.st_value as i128) + (addend as i128);
+                    Ok(GotTarget { address: u64::try_from(value)
+                        .context("GOT target address overflow")?, symbol_name: Some(name.to_string()) })
+                }
+                _ => bail!("unsupported GOT relocation type {}", relocation.r_type),
+            }
+        })().map_err(|error| error.to_string());
+        if targets.contains_key(&relocation.r_offset) {
+            targets.insert(relocation.r_offset, Err("duplicate GOT relocations".to_string()));
+        } else {
+            targets.insert(relocation.r_offset, resolved);
+        }
+    }
+    Ok(targets)
+}
