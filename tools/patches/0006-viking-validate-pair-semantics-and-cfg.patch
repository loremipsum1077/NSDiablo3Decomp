+#[cfg(test)]
+mod pair_encoding_tests {
+    use super::{same_add_encoding, same_memory_encoding};
+
+    #[test]
+    fn only_lo12_immediates_may_change() {
+        for bit in 0..32 {
+            let relocatable = 0x003f_fc00 & (1u32 << bit) != 0;
+            assert_eq!(
+                same_add_encoding(0x9100_0260, 0x9100_0260 ^ (1 << bit)),
+                relocatable
+            );
+            for word in [0xf940_0260, 0xf900_0260, 0x3940_0260, 0xbd40_0260] {
+                assert_eq!(same_memory_encoding(word, word ^ (1 << bit)), relocatable);
+            }
+        }
+    }
+
+    #[test]
+    fn excludes_non_static_addressing_forms() {
+        for word in [0x9140_0260, 0x1100_0260, 0x8b00_0260] {
+            assert!(!same_add_encoding(word, word));
+        }
+        for word in [0xf860_6a60, 0xf840_8e60, 0xf840_8660, 0xa940_0660] {
+            assert!(!same_memory_encoding(word, word));
+        }
+    }
+}
