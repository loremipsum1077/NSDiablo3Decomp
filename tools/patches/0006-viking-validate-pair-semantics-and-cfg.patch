+        let ours = u32::from_le_bytes(rebuilt.code[offset..offset + 4].try_into().unwrap());
+        // Embedded traps and undecodable words must not carry evidence forward.
+        if word == 0xe7ff_defe || is_brk(word) {
+            continue;
+        }
