+// Capstone uses distinct IDs for W/X registers, and special IDs for FP/LR.
+fn gpr_number(cs: &cs::Capstone, reg: cs::RegId) -> Option<u8> {
+    let name = cs.reg_name(reg)?;
+    match name.as_str() {
+        "fp" => Some(29),
+        "lr" => Some(30),
+        _ => name
+            .strip_prefix('x')
+            .or_else(|| name.strip_prefix('w'))?
+            .parse()
+            .ok(),
+    }
+}
