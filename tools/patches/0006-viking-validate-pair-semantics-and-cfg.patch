+// Only these forms have a static relocatable immediate. Preserve every other
+// encoding bit, including ADD shift/width and memory size/opcode/registers.
+fn same_add_encoding(original: u32, rebuilt: u32) -> bool {
+    original & 0xffc0_0000 == 0x9100_0000 && original & !0x003f_fc00 == rebuilt & !0x003f_fc00
+}
+
+fn same_memory_encoding(original: u32, rebuilt: u32) -> bool {
+    original & 0x3b00_0000 == 0x3900_0000 && original & !0x003f_fc00 == rebuilt & !0x003f_fc00
 }
 
