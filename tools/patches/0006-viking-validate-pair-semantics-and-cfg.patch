+            .disasm_all(&original.code[offset..offset + 4], addr)
+            .or_else(translate_cs_error)?;
+        let decoded2 = cs
+            .disasm_all(
+                &rebuilt.code[offset..offset + 4],
+                rebuilt.addr + offset as u64,
+            )
+            .or_else(translate_cs_error)?;
+        let (Some(i1), Some(i2)) = (decoded1.iter().next(), decoded2.iter().next()) else {
+            continue;
         };
-        let mut incoming: Vec<PairSnapshot> = edges;
-        if !self.prev_unconditional {
