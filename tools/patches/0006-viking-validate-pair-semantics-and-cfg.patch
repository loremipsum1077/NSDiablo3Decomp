+        // An indirect jump might enter any local block. A call into the middle
+        // of this function has unresolved return edges. Exact-entry recursion
+        // instead follows the same ABI as other calls: entry already has no
+        // incoming pair evidence, and the continuation loses caller-saved state.
+        let call_target = (addr as i64 + (((word << 6) as i32 >> 6) as i64) * 4) as u64;
+        node.unknown_successors = word & 0xffff_fc1f == 0xd61f_0000
+            || (word & 0xfc00_0000 == 0x9400_0000
+                && original.get_addr_range().contains(&call_target)
+                && call_target != original.addr);
+        // AAPCS64 call-clobbered registers, including platform register x18 and LR.
+        if word & 0xfc00_0000 == 0x9400_0000 || word & 0xffff_fc1f == 0xd63f_0000 {
+            node.killed.extend(0..=18);
+            node.killed.insert(30);
+        }
+        if word & 0x9f00_0000 == 0x9000_0000 && word & 0x9f00_001f == ours & 0x9f00_001f {
+            let d1 = cs.insn_detail(i1).or_else(translate_cs_error)?;
+            let d2 = cs.insn_detail(i2).or_else(translate_cs_error)?;
+            let a1 = d1.arch_detail();
+            let a2 = d2.arch_detail();
+            let op1 = a1.arm64().unwrap().operands_ref();
+            let op2 = a2.arm64().unwrap().operands_ref();
+            let reg = Arm64Operand::from(&op1[0]).op_type.reg();
+            node.generated = Some((
+                reg,
+                (
+                    Arm64Operand::from(&op1[1]).op_type.imm() as u64,
+                    Arm64Operand::from(&op2[1]).op_type.imm() as u64,
+                ),
+            ));
+        }
+        if let Some(target) = direct_branch_target(word, addr) {
+            if original.get_addr_range().contains(&target) && (target - original.addr) % 4 == 0 {
+                node.successors
+                    .push(((target - original.addr) / 4) as usize);
+            }
+        }
+        if !is_unconditional(word) && index + 1 < count {
+            node.successors.push(index + 1);
+        }
+    }
+    let mut entries: Vec<Option<PairSnapshot>> = vec![None; count];
+    let mut work = VecDeque::new();
+    if count > 0 {
+        entries[0] = Some(PairSnapshot::new());
+        work.push_back(0);
+    }
+    while let Some(index) = work.pop_front() {
+        let node = &nodes[index];
+        if node.unknown_successors {
+            return Ok(State {
+                unsupported_flow: true,
+                ..State::default()
+            });
+        }
+        let mut output = entries[index].as_ref().unwrap().clone();
+        output.retain(|reg, _| {
+            gpr_number(cs, *reg).map_or(false, |number| !node.killed.contains(&number))
+        });
+        if let Some((reg, pages)) = node.generated {
+            output.insert(reg, pages);
+        }
+        for &target in &node.successors {
+            let changed = if let Some(old) = &mut entries[target] {
+                let before = old.len();
+                old.retain(|reg, pages| output.get(reg) == Some(pages));
+                before != old.len()
+            } else {
+                entries[target] = Some(output.clone());
+                true
+            };
+            if changed {
+                work.push_back(target);
+            }
+        }
+    }
+    Ok(State {
+        entries: entries
+            .into_iter()
+            .enumerate()
+            .filter_map(|(index, pairs)| {
+                pairs.map(|pairs| (original.addr + index as u64 * 4, pairs))
+            })
+            .collect(),
+        ..State::default()
+    })
+}
