+#[cfg(test)]
+mod adrp_flow_tests {
+    use super::{direct_branch_target, is_unconditional};
+
+    #[test]
+    fn decodes_direct_branches() {
+        let at = 0x22df18u64;
+        assert_eq!(direct_branch_target(0x1400_0004, at), Some(at + 0x10)); // b +0x10
+        assert_eq!(direct_branch_target(0x17ff_fffe, at), Some(at - 8)); // b -8
+        assert_eq!(direct_branch_target(0x5400_0341, at), Some(at + 0x68)); // b.ne
+        assert_eq!(direct_branch_target(0xb400_0088, at), Some(at + 0x10)); // cbz x8
+        assert_eq!(direct_branch_target(0x37f8_0329, at), Some(at + 0x64)); // tbnz w9, #31
+        assert_eq!(direct_branch_target(0x9400_0004, at), None); // bl is a call
+        assert_eq!(direct_branch_target(0xd65f_03c0, at), None); // ret
+    }
+
+    #[test]
+    fn classifies_terminators() {
+        assert!(is_unconditional(0x1400_0004)); // b
+        assert!(is_unconditional(0xd65f_03c0)); // ret
+        assert!(is_unconditional(0xd61f_0200)); // br x16
+        assert!(!is_unconditional(0x5400_0341)); // b.ne
+        assert!(!is_unconditional(0x9400_0004)); // bl
+    }
+}
