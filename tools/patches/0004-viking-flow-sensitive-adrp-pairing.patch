+            state.enter(i1.address());
+            let word = u32::from_le_bytes(i1.bytes()[..4].try_into().unwrap());
+            if let Some(target) = direct_branch_target(word, i1.address()) {
+                if target > i1.address() && orig_fn.get_addr_range().contains(&target) {
+                    state.record_edge(target);
+                }
+            }
+            state.prev_unconditional = is_unconditional(word);
+
             match id.into() {
                 // Branches or function calls.
                 Arm64Insn::ARM64_INS_B | Arm64Insn::ARM64_INS_BL => {
@@ -612,3 +692,29 @@ impl<'a, 'functions, 'orig_elf, 'decomp_elf>
             .or_else(|| elf::plt_addr_to_name(self.decomp_elf, decomp_addr))
     }
 }
