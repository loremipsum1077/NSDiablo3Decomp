+//! Register-indirect tail calls.
+//!
+//! A `br xN` that is not a jump table normally leaves the function: clang emits
+//! it for sibling calls through a vtable slot or a function pointer. Such a
+//! branch is classified as an exit (no local successors) only when, on every
+//! path from the entry, both images agree that
+//!   * SP is back at its entry value,
+//!   * x30 holds the entry return address (never overwritten, or reloaded from
+//!     the stack slot it was saved to), and
+//!   * the branch register was produced in the same straight-line block by a
+//!     plain 64-bit LDR (immediate forms) or a register MOV, never by address
+//!     arithmetic (ADR/ADRP/ADD/SUB) or a register-offset load, which is how
+//!     jump tables and other computed local targets are formed.
+//! Anything else stays an unresolved edge.
+use super::FlowNode;
+use std::collections::BTreeSet;
+
+#[derive(Clone, PartialEq)]
+struct Frame {
+    sp: Option<i64>,
+    fp: Option<i64>,
+    lr: bool,
+    slots: BTreeSet<i64>,
+}
+
+impl Frame {
+    fn entry() -> Self {
+        Frame {
+            sp: Some(0),
+            fp: None,
+            lr: true,
+            slots: BTreeSet::new(),
+        }
+    }
+
+    fn unknown() -> Self {
+        Frame {
+            sp: None,
+            fp: None,
+            lr: false,
+            slots: BTreeSet::new(),
+        }
+    }
+
+    fn meet(&self, other: &Frame) -> Frame {
+        Frame {
+            sp: if self.sp == other.sp { self.sp } else { None },
+            fp: if self.fp == other.fp { self.fp } else { None },
+            lr: self.lr && other.lr,
+            slots: self.slots.intersection(&other.slots).copied().collect(),
+        }
+    }
+
+    fn base(&self, rn: u32) -> Option<i64> {
+        match rn {
+            31 => self.sp,
+            29 => self.fp,
+            _ => None,
+        }
+    }
+
+    fn write_back(&mut self, rn: u32, value: Option<i64>) {
+        match rn {
+            31 => self.sp = value,
+            29 => self.fp = value,
+            30 => self.lr = false,
+            _ => {}
+        }
+    }
+
+    fn store(&mut self, address: Option<i64>, reg: u32, size: i64, is_gpr: bool) {
+        let Some(address) = address else {
+            // Stores through other bases are assumed not to alias the frame's
+            // save area; sp/x29-relative stores are tracked exactly.
+            return;
+        };
+        self.slots.retain(|&slot| slot + 8 <= address || address + size <= slot);
+        if is_gpr && reg == 30 && size == 8 && self.lr {
+            self.slots.insert(address);
+        }
+    }
+
+    fn load(&mut self, address: Option<i64>, reg: u32, is_gpr: bool) {
+        if !is_gpr {
+            return;
+        }
+        match reg {
+            30 => self.lr = address.map_or(false, |a| self.slots.contains(&a)),
+            29 => self.fp = None,
+            _ => {}
+        }
+    }
+}
+
+fn sext(value: u32, bits: u32) -> i64 {
+    ((value << (32 - bits)) as i32 >> (32 - bits)) as i64
+}
+
+fn step(frame: &mut Frame, word: u32) {
+    let rd = word & 31;
+    let rn = (word >> 5) & 31;
+    // BL / BLR: the callee returns with SP preserved and LR clobbered.
+    if word & 0xfc00_0000 == 0x9400_0000 || word & 0xffff_fc1f == 0xd63f_0000 {
+        frame.lr = false;
+        return;
+    }
+    // Add/sub immediate.
+    if word & 0x1f00_0000 == 0x1100_0000 {
+        let sf = word >> 31 == 1;
+        let sub = (word >> 30) & 1 == 1;
+        let flags = (word >> 29) & 1 == 1;
+        let mut imm = ((word >> 10) & 0xfff) as i64;
+        if (word >> 22) & 1 == 1 {
+            imm <<= 12;
+        }
+        let delta = if sub { -imm } else { imm };
+        if !flags && (rd == 31 || rd == 29) {
+            let value = if sf { frame.base(rn).map(|v| v + delta) } else { None };
+            if rd == 31 {
+                frame.sp = value;
+            } else {
+                frame.fp = value;
+            }
+            return;
+        }
+    }
+    // Add/sub extended register and logical immediate may target SP.
+    if (word & 0x1f20_0000 == 0x0b20_0000 && (word >> 29) & 1 == 0 && rd == 31)
+        || (word & 0x1f80_0000 == 0x1200_0000 && (word >> 29) & 3 != 3 && rd == 31)
+    {
+        frame.sp = None;
+        return;
+    }
+    // Load/store pair.
+    if word & 0x3a00_0000 == 0x2800_0000 {
+        let mode = (word >> 23) & 3;
+        let load = (word >> 22) & 1 == 1;
+        let vector = (word >> 26) & 1 == 1;
+        let opc = word >> 30;
+        let scale: i64 = if vector { 4 << opc } else if opc == 2 { 8 } else { 4 };
+        let imm = sext((word >> 15) & 0x7f, 7) * scale;
+        let (rt, rt2) = (word & 31, (word >> 10) & 31);
+        let base = frame.base(rn);
+        let address = match mode {
+            1 => base,
+            _ => base.map(|b| b + imm),
+        };
+        if mode == 1 || mode == 3 {
+            frame.write_back(rn, base.map(|b| b + imm));
+        }
+        if load {
+            frame.load(address, rt, !vector);
+            frame.load(address.map(|a| a + scale), rt2, !vector);
+        } else {
+            frame.store(address, rt, scale, !vector);
+            frame.store(address.map(|a| a + scale), rt2, scale, !vector);
+        }
+        return;
+    }
+    // Load/store single register (immediate and register-offset forms).
+    if word & 0x3a00_0000 == 0x3800_0000 {
+        let vector = (word >> 26) & 1 == 1;
+        let size = word >> 30;
+        let opc = (word >> 22) & 3;
+        let bytes: i64 = if vector && opc & 2 == 2 { 16 } else { 1 << size };
+        let load = if vector { opc & 1 == 1 } else { opc != 0 };
+        let base = frame.base(rn);
+        let rt = word & 31;
+        let (address, writeback) = if (word >> 24) & 1 == 1 {
+            (base.map(|b| b + ((word >> 10) & 0xfff) as i64 * bytes), None)
+        } else if (word >> 21) & 1 == 1 {
+            (None, None) // register offset
+        } else {
+            let imm = sext((word >> 12) & 0x1ff, 9);
+            match (word >> 10) & 3 {
+                1 => (base, Some(base.map(|b| b + imm))),
+                3 => (base.map(|b| b + imm), Some(base.map(|b| b + imm))),
+                _ => (base.map(|b| b + imm), None),
+            }
+        };
+        if let Some(value) = writeback {
+            frame.write_back(rn, value);
+        }
+        if load {
+            frame.load(address, rt, !vector);
+        } else {
+            frame.store(address, rt, bytes, !vector);
+        }
+        return;
+    }
+    // Load-exclusive/store-exclusive and atomics: status/destination registers.
+    if word & 0x3f00_0000 == 0x0800_0000 && ((word >> 16) & 31 == 30 || rd == 30) {
+        frame.lr = false;
+    }
+    // Anything else that names x29/x30 as Rd (or Rt) is treated as a write.
+    if rd == 30 {
+        frame.lr = false;
+    } else if rd == 29 {
+        frame.fp = None;
+    }
+}
+
+fn frames(words: &[u32], nodes: &[FlowNode]) -> Vec<Option<Frame>> {
+    let count = nodes.len();
+    let mut reached = vec![false; count];
+    let mut stack = if count == 0 { vec![] } else { vec![0] };
+    while let Some(n) = stack.pop() {
+        if !reached[n] {
+            reached[n] = true;
+            stack.extend(nodes[n].successors.iter().copied().filter(|&t| t < count));
+        }
+    }
+    let mut incoming = vec![Vec::new(); count];
+    for (source, node) in nodes.iter().enumerate() {
+        for &target in &node.successors {
+            if target < count {
+                incoming[target].push(source);
+            }
+        }
+    }
+    let mut output: Vec<Option<Frame>> = vec![None; count];
+    let entry_of = |n: usize, output: &Vec<Option<Frame>>| -> Option<Frame> {
+        let mut result = if n == 0 { Some(Frame::entry()) } else { None };
+        for &p in &incoming[n] {
+            let value = if reached[p] {
+                match &output[p] {
+                    Some(v) => v.clone(),
+                    None => continue,
+                }
+            } else {
+                // Flow the CFG does not model (landing pads) is not trusted.
+                Frame::unknown()
+            };
+            result = Some(match result {
+                None => value,
+                Some(acc) => acc.meet(&value),
+            });
+        }
+        result
+    };
+    let mut queue: std::collections::VecDeque<usize> =
+        (0..count).filter(|&n| reached[n]).collect();
+    let mut rounds = 0usize;
+    while let Some(n) = queue.pop_front() {
+        rounds += 1;
+        if rounds > count.saturating_mul(64).max(4096) {
+            return vec![None; count];
+        }
+        let Some(mut frame) = entry_of(n, &output) else {
+            continue;
+        };
+        step(&mut frame, words[n]);
+        if output[n].as_ref() != Some(&frame) {
+            output[n] = Some(frame);
+            for &t in &nodes[n].successors {
+                if t < count && reached[t] {
+                    queue.push_back(t);
+                }
+            }
+        }
+    }
+    (0..count).map(|n| if reached[n] { entry_of(n, &output) } else { None }).collect()
+}
+
+/// The branch register must come from a plain LDR (immediate forms) or MOV in
+/// the same straight-line run, with no address arithmetic.
+fn plain_source(words: &[u32], nodes: &[FlowNode], branch: usize) -> bool {
+    let target = (words[branch] >> 5) & 31;
+    let mut at = branch;
+    for _ in 0..32 {
+        if at == 0 {
+            return false;
+        }
+        let previous = at - 1;
+        if nodes[previous].successors != [at] {
+            return false;
+        }
+        let word = words[previous];
+        let writes_target = word & 31 == target
+            && !(word & 0x3a00_0000 == 0x3800_0000 && word & (3 << 22) == 0) // store
+            && !(word & 0x3a00_0000 == 0x2800_0000 && (word >> 22) & 1 == 0);
+        let pair_writes = word & 0x3a00_0000 == 0x2800_0000
+            && (word >> 22) & 1 == 1
+            && (word >> 10) & 31 == target;
+        if pair_writes {
+            return false;
+        }
+        if writes_target {
+            // LDR Xt, [Xn, #imm] (unsigned offset), LDUR / pre / post index.
+            let ldr_unsigned = word & 0xffc0_0000 == 0xf940_0000;
+            let ldr_unscaled = word & 0xffe0_0000 == 0xf840_0000 && (word >> 10) & 3 != 2;
+            let mov = word & 0xffe0_ffe0 == 0xaa00_03e0;
+            return ldr_unsigned || ldr_unscaled || mov;
+        }
+        at = previous;
+    }
+    false
+}
+
+/// Marks proven tail calls as exits. Returns whether anything changed.
+pub(super) fn resolve(original: &[u32], rebuilt: &[u32], nodes: &mut [FlowNode]) -> bool {
+    let candidates: Vec<usize> = (0..nodes.len())
+        .filter(|&n| {
+            nodes[n].unknown_successors
+                && original[n] & 0xffff_fc1f == 0xd61f_0000
+                && rebuilt[n] & 0xffff_fc1f == 0xd61f_0000
+                && (original[n] >> 5) & 31 != 30
+        })
+        .collect();
+    if candidates.is_empty() {
+        return false;
+    }
+    let left = frames(original, nodes);
+    let right = frames(rebuilt, nodes);
+    let mut changed = false;
+    for n in candidates {
+        let ok = |frame: &Option<Frame>| {
+            frame
+                .as_ref()
+                .map_or(false, |f| f.sp == Some(0) && f.lr)
+        };
+        if ok(&left[n])
+            && ok(&right[n])
+            && plain_source(original, nodes, n)
+            && plain_source(rebuilt, nodes, n)
+        {
+            nodes[n].unknown_successors = false;
+            nodes[n].successors.clear();
+            changed = true;
+        }
+    }
+    changed
+}
