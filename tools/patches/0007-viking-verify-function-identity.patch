+fn verify_link_map_provenance(elf: &OwnedElf, path: &Path, map: &[u8]) -> Result<()> {
+    let receipt_path = PathBuf::from(format!("{}.provenance", path.display()));
+    let receipt: LinkMapProvenance = serde_json::from_slice(
+        &std::fs::read(&receipt_path).with_context(|| format!("missing link provenance {}; relink", receipt_path.display()))?
+    ).context("invalid link provenance")?;
+    anyhow::ensure!(receipt.format == 1, "unsupported link provenance format");
+    anyhow::ensure!(receipt.elf_sha256 == crate::sha256::hex(&elf.as_owner().1),
+        "stale link provenance: ELF hash mismatch; relink");
+    anyhow::ensure!(receipt.map_sha256 == crate::sha256::hex(map),
+        "stale link provenance: map hash mismatch; relink");
     Ok(())
 }
 
