+/// A missing entry must not revive a rejected ELF identity through PLT fallback.
+pub fn has_defined_symbol(elf: &OwnedElf, name: &str) -> bool {
+    let Ok(strings) = SymbolStringTable::from_elf(elf) else { return true; };
+    elf.syms.iter().any(|symbol| symbol.st_shndx != section_header::SHN_UNDEF as usize
+        && strings.get_string(symbol.st_name) == name)
+}
