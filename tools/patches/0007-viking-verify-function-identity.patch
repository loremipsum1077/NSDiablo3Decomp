+fn same_symbol_identity(a: &Sym, b: &Sym) -> bool {
+    a.st_value == b.st_value && a.st_size == b.st_size && a.st_shndx == b.st_shndx
+        && a.st_info == b.st_info && a.st_other == b.st_other
+}
+
+/// Distinct function names at one address are aliases only when the complete
+/// extent and defining section agree. This proves code identity, not TU ownership.
+fn conflicting_function_addresses(elf: &OwnedElf) -> HashSet<u64> {
+    let mut first = HashMap::new();
+    let mut conflicts = HashSet::new();
+    for symbol in elf.syms.iter().filter(|s| s.st_type() == sym::STT_FUNC
+        && s.st_shndx != section_header::SHN_UNDEF as usize) {
+        let identity = (symbol.st_size, symbol.st_shndx);
+        if let Some(previous) = first.insert(symbol.st_value, identity) {
+            if previous != identity { conflicts.insert(symbol.st_value); }
+        }
+    }
+    conflicts
+}
