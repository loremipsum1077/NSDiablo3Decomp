+/// BRK has a 16-bit immediate in bits 20:5; every other bit is fixed.
+fn is_brk(word: u32) -> bool {
+    word & 0xffe0_001f == 0xd420_0000
+}
+
+/// Compare the non-relocated bits of B, B.cond and BL.
+fn same_branch_encoding(original: u32, ours: u32) -> bool {
+    let immediate = if original & 0xff00_0010 == 0x5400_0000 {
+        0x00ff_ffe0 // B.cond imm19; retain the condition in bits 3:0.
+    } else {
+        0x03ff_ffff // B / BL imm26.
+    };
+    original & !immediate == ours & !immediate
+}
