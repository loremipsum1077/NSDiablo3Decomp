+
+#[cfg(test)]
+mod strict_encoding_tests {
+    use super::{is_brk, same_branch_encoding};
+
+    #[test]
+    fn accepts_only_brk_encodings() {
+        for immediate in 0..=0xffff {
+            assert!(is_brk(0xd420_0000 | (immediate << 5)));
+        }
+        for bit in 0..32 {
+            if (0xffe0_001f & (1u32 << bit)) != 0 {
+                assert!(!is_brk(0xd420_0000 ^ (1u32 << bit)));
+            }
+        }
+    }
+
+    #[test]
+    fn relocated_branches_retain_condition_and_opcode() {
+        assert!(same_branch_encoding(0x5400_0020, 0x54ff_ffe0));
+        assert!(!same_branch_encoding(0x5400_0020, 0x5400_0021));
+        assert!(same_branch_encoding(0x1400_0004, 0x17ff_fffe));
+        assert!(same_branch_encoding(0x9400_0004, 0x97ff_fffe));
+        assert!(!same_branch_encoding(0x1400_0004, 0x9400_0004));
+    }
+}
