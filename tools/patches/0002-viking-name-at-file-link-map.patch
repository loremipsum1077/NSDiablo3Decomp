+/// `name@file`: a function whose mangled name several translation units
+/// define (a file-static, an anonymous-namespace function) is keyed in
+/// functions.csv by name *and* the TU that owns the copy -- `file` is a
+/// path suffix of that TU (`UIConsoleEnchantView.cpp`, or `Console/Foo.cpp`
+/// when two duplicates share a basename). The built ELF carries neither
+/// STT_FILE symbols nor DWARF, so the qualifier is resolved through the link
+/// map ld.lld writes next to the ELF (`-Map`, see CMakeLists.txt).
+/// tools/symname.py owns the same convention on the Python side.
+pub const QUALIFIER_SEP: char = '@';
+
+pub fn split_qualified(name: &str) -> (&str, Option<&str>) {
+    match name.split_once(QUALIFIER_SEP) {
+        Some((bare, qual)) => (bare, Some(qual.trim_matches('/'))),
+        None => (name, None),
+    }
+}
+
+/// Does a link-map object path (`.../src/X/.../Foo.cpp.obj`) end with the
+/// qualifier on a path-component boundary?
+pub fn object_matches_qualifier(object: &str, qual: &str) -> bool {
+    let mut p = object.replace('\\', "/");
+    for ext in [".obj", ".o"] {
+        if let Some(stripped) = p.strip_suffix(ext) {
+            p = stripped.to_string();
+            break;
+        }
+    }
+    let q = qual.trim_matches('/');
+    !q.is_empty() && (p == q || p.ends_with(&format!("/{q}")))
+}
+
+pub struct LinkMapSymbol {
+    pub name: String,
+    pub object: String,
+    pub addr: u64,
+}
+
+pub fn link_map_path(version: Option<&str>) -> Result<PathBuf> {
+    Ok(repo::get_build_path(version)?.join(format!("{}.map", repo::get_config().build_target)))
+}
+
+pub fn load_link_map(version: Option<&str>) -> Result<Vec<LinkMapSymbol>> {
+    let path = link_map_path(version)?;
+    let text = std::fs::read_to_string(&path).with_context(|| {
+        format!(
+            "a name@file needs the link map {} -- relink (the CMake link passes -Map)",
+            path.display()
+        )
+    })?;
+    parse_link_map(&text)
+}
+
+/// Parse an ld.lld `-Map` file into (symbol, defining object, address).
+/// Both layouts are accepted -- LLD <= 9 `Address Size Align Out In Symbol`
+/// and LLD >= 10 `VMA LMA Size Align Out In Symbol` -- by skipping the
+/// header's numeric columns and classifying each row by the column its
+/// text starts in (Out / In / Symbol), which lld pads to fixed widths.
+pub fn parse_link_map(text: &str) -> Result<Vec<LinkMapSymbol>> {
+    fn tokens(line: &str) -> Vec<(usize, &str)> {
+        let mut out = Vec::new();
+        let mut start = None;
+        for (i, c) in line.char_indices() {
+            match (c.is_ascii_whitespace(), start) {
+                (false, None) => start = Some(i),
+                (true, Some(s)) => {
+                    out.push((s, &line[s..i]));
+                    start = None;
+                }
+                _ => {}
+            }
+        }
+        if let Some(s) = start {
+            out.push((s, &line[s..]));
+        }
+        out
+    }
+
+    let mut lines = text.lines();
+    let header = lines
+        .find(|l| l.contains("Symbol") && l.contains(" In ") && l.contains("Out"))
+        .context("not an ld.lld map file (no `Out In Symbol` header)")?;
+    let htoks = tokens(header);
+    let numeric_cols = htoks.iter().position(|(_, t)| *t == "Out").context("map header has no Out column")?;
+    let col_in = htoks.iter().find(|(_, t)| *t == "In").map(|(o, _)| *o).unwrap();
+    let col_sym = htoks.iter().find(|(_, t)| *t == "Symbol").map(|(o, _)| *o).unwrap();
+
+    let mut out = Vec::new();
+    let mut object = String::new();
+    for line in lines {
+        let toks = tokens(line);
+        if toks.len() <= numeric_cols {
+            continue;
+        }
+        let Ok(addr) = u64::from_str_radix(toks[0].1.trim_start_matches("0x"), 16) else {
+            continue;
+        };
+        let (start, _) = toks[numeric_cols];
+        let rest = line[start..].trim_end();
+        if start >= col_sym {
+            if !object.is_empty() {
+                out.push(LinkMapSymbol {
+                    name: rest.to_string(),
+                    object: object.clone(),
+                    addr,
+                });
+            }
+        } else if start >= col_in {
+            // `<object>:(<input section>)`; an archive member is `lib.a(x.o)`
+            object = rest.rsplit_once(":(").map_or("", |(o, _)| o).to_string();
+        } else {
+            object.clear(); // an output section header
+        }
+    }
+    Ok(out)
+}
+
+pub fn resolve_qualified_in_map<'m>(
+    map: &'m [LinkMapSymbol],
+    bare: &str,
+    qual: &str,
+) -> Result<&'m LinkMapSymbol> {
+    let hits: Vec<&LinkMapSymbol> = map
+        .iter()
+        .filter(|m| m.name == bare && object_matches_qualifier(&m.object, qual))
+        .collect();
+    match hits.as_slice() {
+        [one] => Ok(one),
+        [] => bail!("{bare}@{qual}: no object matching {qual:?} defines {bare} (per the link map)"),
+        many => bail!(
+            "{bare}@{qual}: {} objects match {qual:?}: {} -- lengthen the qualifier",
+            many.len(),
+            many.iter().map(|m| m.object.as_str()).collect::<Vec<_>>().join(", ")
+        ),
+    }
+}
+
+/// Give every `name@file` functions.csv name its own entry in `symtab`,
+/// resolved through the link map. A name the map cannot pin is skipped --
+/// an undecompiled row is allowed to be unresolvable -- and an ambiguous
+/// one is reported on stderr. Without a map file nothing is added; a
+/// one-line note says so when qualified names were seen.
+pub fn add_qualified_names<'a, I, S>(
+    symtab: &mut SymbolTableByName<'a>,
+    elf: &OwnedElf,
+    version: Option<&str>,
+    names: I,
+) -> Result<()>
+where
+    I: IntoIterator<Item = S>,
+    S: AsRef<str>,
+{
+    let qualified: Vec<String> = names
+        .into_iter()
+        .map(|s| s.as_ref().to_string())
+        .filter(|n| n.contains(QUALIFIER_SEP))
+        .collect();
+    if qualified.is_empty() {
+        return Ok(());
+    }
+    let path = link_map_path(version)?;
+    let text = match std::fs::read_to_string(&path) {
+        Ok(t) => t,
+        Err(_) => {
+            eprintln!(
+                "note: {} name@file function(s) but no link map at {}; relink to check them",
+                qualified.len(),
+                path.display()
+            );
+            return Ok(());
+        }
+    };
+    let map = parse_link_map(&text)?;
+    let by_addr = make_symbol_map_by_addr(elf);
+    for name in qualified {
+        if symtab.contains_key(name.as_str()) {
+            continue;
+        }
+        let (bare, Some(qual)) = split_qualified(&name) else {
+            continue;
+        };
+        let hit = match resolve_qualified_in_map(&map, bare, qual) {
+            Ok(h) => h,
+            Err(e) if e.to_string().contains("no object matching") => continue, // not linked (yet)
+            Err(e) => {
+                eprintln!("warning: {e}");
+                continue;
+            }
+        };
+        match by_addr.get(&hit.addr) {
+            Some(sym) if sym.st_type() == sym::STT_FUNC => {
+                // the map's keys borrow from the ELF; a handful of qualified
+                // spellings per run are worth leaking for the same lifetime
+                let key: &'static str = Box::leak(name.clone().into_boxed_str());
+                symtab.insert(key, *sym);
+            }
+            _ => eprintln!(
+                "warning: {name}: link map puts it at {:#x} but the ELF has no function symbol there",
+                hit.addr
+            ),
+        }
+    }
+    Ok(())
+}
