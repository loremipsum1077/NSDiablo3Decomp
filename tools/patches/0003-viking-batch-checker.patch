+
+/// Check a list selected by the caller's CSV identities.  Unlike check_single,
+/// this never fuzzy-searches or prompts: accepting a partial name here would
+/// make a bulk gate capable of checking the wrong duplicate/overload.
+///
+/// FunctionChecker and all of its ELF, symbol, PLT, and global-data inputs are
+/// constructed by main before this runs.  Status changes are accumulated and
+/// written once, so a batch has the same promotion semantics as individual
+/// `check NAME` calls without the lost-update race of multiple processes.
+fn check_batch(
+    checker: &FunctionChecker,
+    functions: &[functions::Info],
+    request_path: &Path,
+    output_path: &Path,
+    version: Option<&str>,
+) -> Result<()> {
+    let request_text = std::fs::read_to_string(request_path)
+        .with_context(|| format!("failed to read batch request {}", request_path.display()))?;
+    let request: BatchRequest = serde_json::from_str(&request_text)
+        .with_context(|| format!("failed to parse batch request {}", request_path.display()))?;
+
+    let by_addr: HashMap<u64, &functions::Info> = functions
+        .iter()
+        .map(|function| (function.addr, function))
+        .collect();
+    let mut changed_statuses = HashMap::new();
+    let mut cs = make_cs()?;
+    let mut results = Vec::with_capacity(request.functions.len());
+
+    for identity in request.functions {
+        let mut result = BatchResult {
+            address: identity.address.clone(),
+            name: identity.name.clone(),
+            status: "not-checkable".to_string(),
+            reason: String::new(),
+        };
+
+        let addr = match functions::parse_address(&identity.address) {
+            Ok(addr) => addr,
+            Err(error) => {
+                result.reason = format!("invalid address: {error}");
+                results.push(result);
+                continue;
+            }
+        };
+        let Some(function) = by_addr.get(&addr).copied() else {
+            result.reason = "address is not present in functions.csv".to_string();
+            results.push(result);
+            continue;
+        };
+        if function.name != identity.name {
+            result.reason = format!(
+                "identity name disagrees with functions.csv (expected {:?})",
+                function.name
+            );
+            results.push(result);
+            continue;
+        }
+        if matches!(function.status, Status::Library) {
+            result.reason = "L functions should not be decompiled".to_string();
+            results.push(result);
+            continue;
+        }
+
+        let decomp_fn = match elf::get_function_by_name(
+            checker.decomp_elf,
+            checker.decomp_symtab,
+            function.name.as_str(),
+        ) {
+            Ok(function) => function,
+            Err(error) => {
+                result.reason = error.to_string();
+                results.push(result);
+                continue;
+            }
+        };
+        let orig_fn = match elf::get_function(checker.orig_elf, function.addr, function.size as u64)
+        {
+            Ok(function) => function,
+            Err(error) => {
+                result.reason = error.to_string();
+                results.push(result);
+                continue;
+            }
+        };
+
+        match checker.check(&mut cs, &orig_fn, &decomp_fn) {
+            Ok(None) => {
+                result.status = "ok".to_string();
+                if function.status != Status::Matching {
+                    changed_statuses.insert(function.addr, Status::Matching);
+                }
+            }
+            Ok(Some(mismatch)) => {
+                result.status = "mismatch".to_string();
+                result.reason = mismatch.to_string();
+                if function.status == Status::NotDecompiled {
+                    changed_statuses.insert(function.addr, Status::Wip);
+                }
+            }
+            Err(error) => {
+                result.reason = format!("checking {}: {error}", function.name);
+            }
+        }
+        results.push(result);
+    }
+
+    // This is intentionally after every comparison and before publishing the
+    // response. A successful response therefore describes the same CSV state
+    // that individual check_single calls would have left behind.
+    update_function_statuses(functions, &changed_statuses, version)
+        .context("failed to update function statuses after batch check")?;
+
+    let response = BatchResponse { format: 1, results };
+    let encoded = serde_json::to_vec_pretty(&response).context("failed to encode batch results")?;
+    std::fs::write(output_path, encoded)
+        .with_context(|| format!("failed to write batch result {}", output_path.display()))?;
+    Ok(())
+}
